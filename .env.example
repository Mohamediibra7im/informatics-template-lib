DATABASE_URL=postgresql://user:pass@ep-...neon.tech/neondb
ADMIN_PASSWORD=your-secure-password
JWT_SECRET=your-jwt-secret-key-change-this
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# SMTP (contribution approval/rejection emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Optional. Defaults to SMTP_USER. Must be an address your SMTP provider is
# authorized to send as (your Gmail address for Gmail SMTP), or a verified domain.
SMTP_FROM="Informatics Template Lib <your-email@gmail.com>"
# Where new-contribution review alerts go (defaults to SMTP_USER if unset)
ADMIN_EMAIL=your-email@gmail.com

# PDF renderer container base URL (pdf-service). PDFs will not generate without it.
PDF_SERVICE_URL=https://your-pdf-service-url
# Shared secret between the app and the pdf-service (required when the renderer is public, e.g. Fly).
PDF_SERVICE_TOKEN=change-me-to-a-long-random-string
